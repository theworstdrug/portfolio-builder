# Copy to ".env", fill in, then:  docker compose up -d --build   (or without Docker: see deploy/portfolio.service)

# ---- HTTPS ----------------------------------------------------------------
# letsencrypt = the app gets & renews its own certificates (needs ports 80 + 443 open)
# off         = plain HTTP (testing, or when something else in front handles HTTPS)
# manual      = your own certificate files (set TLS_CERT / TLS_KEY)
TLS_MODE=letsencrypt

# Every name here must have a DNS A/AAAA record pointing at this server.
DOMAIN=example.com,www.example.com

# Let's Encrypt sends expiry warnings here (only if renewal somehow keeps failing).
LETSENCRYPT_EMAIL=you@example.com

# Set to true for a first dry run: certificates are untrusted, but rate limits are generous.
# Switch back to false once the staging certificate is issued.
LETSENCRYPT_STAGING=false

# TLS_CERT=/data/certs/my-fullchain.pem
# TLS_KEY=/data/certs/my-privkey.pem

# ---- Email ----------------------------------------------------------------
# Used for "Forgot password?" links and certificate alerts.
# Default: the mail server on this machine (Postfix, see docs/ionos.md). Set SMTP_HOST=off to disable.
SMTP_HOST=localhost
SMTP_PORT=25
# To send through a provider instead (e.g. an IONOS mailbox):
# SMTP_HOST=smtp.ionos.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=mailbox-password
MAIL_FROM=Portfolio <noreply@example.com>
# Fallback recovery address; the client can set her own in Admin → Site.
ADMIN_EMAIL=

# ---- Site -----------------------------------------------------------------
# First admin password. It can be changed later in Admin → Site (then stored in data/auth.json).
ADMIN_PASSWORD=change-me-to-something-long

# Largest single upload, in MB.
MAX_UPLOAD_MB=1024
