# Copy this file to ".env" and fill it in, then: docker compose up -d --build

# Your domain(s), comma separated. Caddy gets HTTPS certificates for these automatically.
# Leave as :80 to test on a plain IP address without a domain.
DOMAIN=nanarium.com, www.nanarium.com

# First admin password. The client can change it later in Admin → Site (it is then stored in data/auth.json).
ADMIN_PASSWORD=change-me-to-something-long

# Largest single upload, in MB.
MAX_UPLOAD_MB=1024
