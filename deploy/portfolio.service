# systemd unit for running without Docker (e.g. from the release bundle).
#   1. unpack the release to /opt/portfolio   (node_modules is included; needs Node 18+)
#   2. cp .env.example .env  and fill it in (TLS_MODE, DOMAIN, LETSENCRYPT_EMAIL, ADMIN_PASSWORD)
#   3. sudo mkdir -p /opt/portfolio/data && sudo chown -R www-data /opt/portfolio/data
#   4. sudo cp deploy/portfolio.service /etc/systemd/system/ && sudo systemctl enable --now portfolio
#   5. journalctl -u portfolio -f    to watch the certificate being issued
[Unit]
Description=Portfolio site
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/portfolio
EnvironmentFile=/opt/portfolio/.env
Environment=DATA_DIR=/opt/portfolio/data
Environment=PORT=80
ExecStart=/usr/bin/node server.js
Restart=always
User=www-data
# lets a non-root user bind ports 80/443
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
